# Required when NODE_ENV=production. Supply real values only on the host.
NODE_ENV=production
TZ=Europe/Berlin
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=faizan_employer_intelligence
PGUSER=jobintel
PGPASSWORD=REPLACE_ON_THE_DEPLOYMENT_HOST

# Existing operational tuning. Defaults preserve the validated request rate.
MONITOR_REQUEST_GAP_MS=750
PGCONNECT_TIMEOUT_MS=5000

# Optional runtime directories; platform-neutral defaults are used if omitted.
FAIZAN_APP_ROOT=/opt/faizan-monitor/current
FAIZAN_CONFIG_DIR=/etc/faizan-monitor
FAIZAN_LOG_DIR=/var/log/faizan-monitor
FAIZAN_REPORT_DIR=/var/lib/faizan-monitor/reports
FAIZAN_BACKUP_DIR=/var/backups/faizan-monitor
FAIZAN_EXPORT_DIR=/var/lib/faizan-monitor/exports
FAIZAN_TEMP_DIR=/var/lib/faizan-monitor/tmp

# External delivery remains disabled.
PHASE2C_EMAIL_ENABLED=false
PHASE2C_SMTP_HOST=
PHASE2C_SMTP_PORT=
PHASE2C_SMTP_USER=
PHASE2C_SMTP_PASSWORD=
PHASE2C_EMAIL_TO=
PHASE2C_TELEGRAM_ENABLED=false
PHASE2C_TELEGRAM_BOT_TOKEN=
PHASE2C_TELEGRAM_CHAT_ID=
PHASE2C_DESKTOP_ENABLED=false
