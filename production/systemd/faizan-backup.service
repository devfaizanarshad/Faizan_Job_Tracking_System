[Unit]
Description=Backup and verify Faizan employer intelligence database
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
SupplementaryGroups=faizan-monitor
WorkingDirectory=/opt/faizan-monitor/current/monitor
EnvironmentFile=/etc/faizan-monitor/faizan.env
Environment=PGUSER=postgres
Environment=PGHOST=/var/run/postgresql
Environment=PGPASSWORD=
ExecStart=/usr/bin/node /opt/faizan-monitor/current/monitor/production-backup.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/faizan-monitor /var/backups/faizan-monitor
